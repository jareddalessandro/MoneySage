# Copy to .env to override defaults. Everything here is optional.
POSTGRES_DB=moneysage
POSTGRES_USER=moneysage
POSTGRES_PASSWORD=moneysage

# Sign-in. "none" (the default) is an offline install: no accounts, one automatic user, only for your own
# computer or a trusted network. "google" turns on Google sign-in and accounts (sharing is in progress).
# Switching an existing install to "google" hides its data (it belongs to the offline user) until you switch
# back; to carry it over, export it on the Export & import page first and import it after signing in.
AUTH_MODE=none

# Google sign-in (AUTH_MODE=google). In Google Cloud Console: APIs & Services -> OAuth consent screen (set it
# up, External), then Credentials -> Create credentials -> OAuth client ID -> Web application, with the
# authorized redirect URI {PUBLIC_URL}/api/auth/callback (e.g. http://localhost:5180/api/auth/callback).
# Keep the secret only in .env, which git ignores.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The address people open the app at, no trailing slash. Must match the redirect URI above. Google only
# allows https addresses, or http://localhost, so phones on your Wi-Fi can't sign in over a LAN address.
PUBLIC_URL=http://localhost:5180
# Optional: only these Google accounts may sign in (comma-separated). Empty lets anyone in.
ALLOWED_EMAILS=

# Shown on the landing page, Privacy Policy and Terms of Service (AUTH_MODE=google). Set all three before
# letting other people sign up: who runs the site (your name or company), where people reach you about
# their data, and whose law the Terms follow (e.g. "Arizona, United States").
OPERATOR_NAME=
CONTACT_EMAIL=
GOVERNING_LAW=

# Set a password to have the app connect as a separate, restricted database role (created at startup), so
# Postgres row-level security also keeps households and companies apart. Recommended for any hosted install.
APP_DB_PASSWORD=

# Daily stock/crypto price refresh time (Eastern by default, after US market close)
PRICE_REFRESH_HOUR=17
PRICE_REFRESH_MINUTE=30
PRICE_REFRESH_TZ=America/New_York

# Local timezone (decides which month "today" falls in)
TZ=America/Phoenix

# Host ports (change if they clash with something else on your machine)
FRONTEND_PORT=5180
BACKEND_PORT=8100
DB_PORT=5433

# Who can reach the app. 127.0.0.1 = this computer only. 0.0.0.0 = also phones on your Wi-Fi
# (open http://<this PC's IP>:5180; also needs a firewall rule, see the README). No login, so trusted networks only.
FRONTEND_BIND=127.0.0.1
