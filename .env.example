# Copy to .env to override defaults. Everything here is optional.
POSTGRES_DB=moneysage
POSTGRES_USER=moneysage
POSTGRES_PASSWORD=moneysage

# Daily stock/crypto price refresh time (Eastern by default, after US market close)
PRICE_REFRESH_HOUR=17
PRICE_REFRESH_MINUTE=30
PRICE_REFRESH_TZ=America/New_York

# Local timezone (decides which month "today" falls in)
TZ=America/Phoenix

# Host ports (change if they clash with something else on your machine)
FRONTEND_PORT=5180
BACKEND_PORT=8100
DB_PORT=5433

# Who can reach the app. 127.0.0.1 = this computer only. 0.0.0.0 = also phones on your Wi-Fi
# (open http://<this PC's IP>:5180; also needs a firewall rule, see the README). No login, so trusted networks only.
FRONTEND_BIND=127.0.0.1
