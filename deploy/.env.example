# Production settings for deploy/docker-compose.yml. Copy to deploy/.env on the server (new-env.sh does it
# and fills in random passwords), then fill in the rest. Keep it readable only by you (chmod 600): it holds
# every secret. Never commit it.

# ---- Site ----
DOMAIN=tallyvio.com
# Let's Encrypt writes here about certificate problems.
ACME_EMAIL=
TZ=America/Phoenix

# ---- Database (new-env.sh generates the passwords) ----
POSTGRES_DB=tallyvio
POSTGRES_USER=tallyvio
POSTGRES_PASSWORD=
# The restricted role the app connects as, so row-level security applies.
APP_DB_PASSWORD=

# ---- Google sign-in ----
# Google Cloud Console -> Credentials -> your OAuth client: add the authorized redirect URI
# https://tallyvio.com/api/auth/callback (with your DOMAIN).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only these Google accounts can sign in (comma-separated). Empty lets anyone sign up.
ALLOWED_EMAILS=
# Optional: these accounts can open the Admin page (sign-ups and last sign-in; never anyone's finances).
ADMIN_EMAILS=

# ---- Shown on the landing page, Privacy Policy and Terms ----
OPERATOR_NAME=
CONTACT_EMAIL=
GOVERNING_LAW=

# ---- Investment prices ----
# "yahoo" (no account; personal use only under Yahoo's terms) or "tiingo" (TIINGO_API_KEY from tiingo.com).
# Showing prices to other people needs a plan that allows display/redistribution; see deploy/README.md.
PRICE_PROVIDER=yahoo
TIINGO_API_KEY=

# ---- Backups (deploy/README.md, "Backups") ----
# Daily, encrypted with the age public key below, kept BACKUP_KEEP_DAYS days.
BACKUP_TIME=02:15
BACKUP_KEEP_DAYS=30
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=tallyvio
# Leave empty for Amazon S3 and Lightsail buckets; set for other S3-compatible storage.
BACKUP_S3_ENDPOINT=
BACKUP_AWS_REGION=us-east-1
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
# The public half of a key made with age-keygen on your own computer (starts with age1).
BACKUP_AGE_RECIPIENT=
